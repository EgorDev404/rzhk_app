<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+: фон рисуем скруглённым САМИ, радиус берём системный (тот же, что у лаунчера).
      Раньше здесь стояло 0dp в расчёте на то, что лаунчер сам скруглит вид android:id/background.
      Это делают не все: Pixel/Tecno (HiOS) скругляют, а Xiaomi (MIUI/HyperOS) — нет, и виджет был квадратным.
      Если лаунчер скругляет сам, радиусы совпадают и никаких «серпов» по углам не появляется.
    -->
    <dimen name="widget_bg_radius">@android:dimen/system_app_widget_background_radius</dimen>
    <dimen name="widget_inner_radius">16dp</dimen>
    <dimen name="widget_padding">16dp</dimen>
</resources>
