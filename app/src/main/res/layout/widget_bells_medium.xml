<?xml version="1.0" encoding="utf-8"?>
<!-- Компактный вариант: чип, затем кольцо (если хватает ширины) или тонкая полоска прогресса, крупный текст и подпись. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_bg" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="@dimen/widget_padding" android:paddingEnd="@dimen/widget_padding"
        android:paddingTop="12dp" android:paddingBottom="12dp">

        <!-- Чип -->
        <FrameLayout android:layout_width="wrap_content" android:layout_height="24dp">
            <ImageView android:id="@+id/widget_chip_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_chip_bg" android:contentDescription="@null" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="12dp">
                <ImageView android:id="@+id/widget_chip_icon" android:layout_width="14dp" android:layout_height="14dp"
                    android:src="@drawable/ic_widget_school" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1"
                    android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Кольцо + текст -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">

            <FrameLayout android:id="@+id/widget_ring" android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginEnd="10dp" android:visibility="gone">
                <ImageView android:id="@+id/widget_ring_image" android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@null" />
                <TextView android:id="@+id/widget_ring_percent" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:maxLines="1" android:textSize="11sp" android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:id="@+id/widget_big" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:maxLines="1"
                    android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/widget_big_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Тонкая полоска прогресса для узких виджетов (вместо кольца) -->
        <ImageView android:id="@+id/widget_bar" android:layout_width="match_parent" android:layout_height="4dp"
            android:layout_marginTop="6dp" android:scaleType="fitXY" android:visibility="gone" android:contentDescription="@null" />
    </LinearLayout>
</FrameLayout>
