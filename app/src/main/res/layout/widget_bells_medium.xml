<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_bg" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
        android:gravity="center_vertical" android:padding="@dimen/widget_padding">
        <FrameLayout android:id="@+id/widget_ring" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="12dp" android:visibility="gone">
            <ImageView android:id="@+id/widget_ring_image" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@null" />
            <TextView android:id="@+id/widget_ring_percent" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:maxLines="1" android:textStyle="bold" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                <ImageView android:id="@+id/widget_chip_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/widget_chip_bg" android:contentDescription="@null" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"
                    android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp">
                    <ImageView android:id="@+id/widget_chip_icon" android:layout_width="14dp" android:layout_height="14dp"
                        android:src="@drawable/ic_widget_school" android:contentDescription="@null" />
                    <TextView android:id="@+id/widget_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                        android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:maxWidth="150dp" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                <TextView android:id="@+id/widget_big" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="30sp" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:maxLines="1" android:textStyle="bold" />
                <Chronometer android:id="@+id/widget_big_timer" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
                    android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="30sp" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:maxLines="1" android:textStyle="bold" />
            </FrameLayout>
            <TextView android:id="@+id/widget_big_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
