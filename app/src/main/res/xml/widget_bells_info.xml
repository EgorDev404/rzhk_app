<?xml version="1.0" encoding="utf-8"?>
<!--
  Размеры: по умолчанию 4×2, можно уменьшать до 2×1 и растягивать как угодно.
  Раскладка (Strip / Compact / Full) выбирается в BellsWidget по реальным ширине и высоте экземпляра,
  а не по minHeight из этого файла. На Android 12+ работают targetCell*, на старых — minWidth/minHeight.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_bells"
    android:previewLayout="@layout/widget_bells_preview"
    android:widgetCategory="home_screen"
    android:label="@string/widget_bells_label"
    android:description="@string/widget_bells_description" />
